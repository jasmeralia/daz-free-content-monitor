# Discord webhook URL for notifications (required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/data/daz_monitor.log

# Database path
DB_PATH=/app/data/daz_monitor.db

# How often to check for new free items (seconds, default: 3600 = 1 hour)
CHECK_INTERVAL_SECONDS=3600

# Set to true to scrape without writing to DB or sending notifications
DRY_RUN=false

# Set to true to run one cycle and exit
RUN_ONCE=false

# Scraper tuning
PAGE_DELAY_MIN=2.0
PAGE_DELAY_MAX=5.0
PAGE_TIMEOUT_MS=30000
MAX_RETRIES=3

# Seconds to wait after container start before first check (default: 15)
STARTUP_DELAY_SECONDS=15

# IANA timezone name for display timestamps (default: America/Los_Angeles)
DISPLAY_TIMEZONE=America/Los_Angeles
